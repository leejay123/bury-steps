# These three values go in Vercel, not in a file on your computer.
# Vercel project → Settings → Environment Variables
# See the README for the click-by-click setup.

# Clerk → your app → API Keys (starts with pk_test_ or pk_live_)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."

# Clerk → your app → API Keys (starts with sk_test_ or sk_live_)
CLERK_SECRET_KEY="sk_test_..."

# Supabase → Connect → Session pooler (port 5432). Keep 5432 in Vercel.
# The app switches to transaction pooling (6543) by itself when serving pages.
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-eu-west-2.pooler.supabase.com:5432/postgres"

# Optional. Production share links use https://burysteps-walkinggroup.co.uk anyway.
# NEXT_PUBLIC_APP_URL="https://burysteps-walkinggroup.co.uk"

# Required in Vercel so the nightly health-note purge is not public.
# Vercel Cron sends this automatically as Authorization: Bearer <value>.
CRON_SECRET="generate-a-long-random-string"

# Strongly recommended. The very first person to sign up against an empty
# database automatically becomes organiser — set this to the intended
# organiser's email so that only happens for them (a fresh deploy, a wiped
# preview environment, or a botched migration can't hand a stranger
# organiser access instead). Leave unset only for local development.
# INITIAL_ADMIN_EMAIL="you@example.com"

# Resend dashboard → API Keys → Create API Key. Without it, all outgoing
# email (welcome, account deletion/promotion, contact form, newsletter) is
# skipped and just logged to the server console — the app still works.
# RESEND_API_KEY="re_..."

# The "From" address for every email. Must be on a domain you've verified in
# Resend (dashboard → Domains) — burysteps-walkinggroup.co.uk, for example.
# donotreply@ is fine as the address itself — it never needs to be a real,
# monitored inbox. The one email a member might actually reply to (the
# contact-form alert sent to organisers) already overrides this with its own
# Reply-To (the visitor's address), regardless of what's set here.
# Until a domain is verified, leave this unset: emails fall back to Resend's
# onboarding@resend.dev test sender, which only delivers to the Resend
# account's own inbox — fine for local testing, not for real members.
# EMAIL_FROM="Bury Steps Walking Group <donotreply@burysteps-walkinggroup.co.uk>"
