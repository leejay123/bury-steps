generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MEMBER
  ADMIN
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String
  firstName String?
  lastName  String?
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now())

  walksCreated     Walk[]           @relation("WalkCreator")
  attendances      Attendance[]
  noticeReads      SiteNoticeRead[]
  accidentReports  AccidentReport[]

  @@index([createdAt])
}

model Walk {
  id           String    @id @default(cuid())
  /// Unguessable slug used in the share link: /w/<token>
  token        String    @unique
  title        String
  description  String?
  location     String?
  /// Set from the meeting point via OpenStreetMap Nominatim. Null if unknown.
  latitude     Float?
  longitude    Float?
  /// Stored in UTC. Always render with timeZone: "Europe/London".
  startsAt     DateTime
  durationMins Int       @default(90)
  cancelledAt  DateTime?
  cancelledReason String?
  createdAt    DateTime  @default(now())

  createdById String
  createdBy   User   @relation("WalkCreator", fields: [createdById], references: [id])

  attendances      Attendance[]
  accidentReports  AccidentReport[]

  @@index([startsAt])
  @@index([createdById])
  /// Used by the dashboard's "recently cancelled" window and the daily
  /// purge cron's cutoff query.
  @@index([cancelledAt])
}

model Attendance {
  id     String @id @default(cuid())
  walkId String
  userId String

  /// Set by the database, never by the client.
  clockedInAt  DateTime @default(now())
  /// When the member left the walk. Null while they are still clocked in.
  clockedOutAt DateTime?
  /// Why they clocked out. Visible to organisers only.
  clockedOutReason String?
  /// When the member gave explicit consent to store health information.
  medicalAckAt DateTime

  /// UK GDPR Art. 9 special category data. Nullable — members may leave it blank.
  conditions           String?
  /// Cron/route clears `conditions` after this date. Retention limit.
  conditionsPurgeAfter DateTime

  walk Walk @relation(fields: [walkId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([walkId, userId])
  @@index([walkId])
  /// Covers `WHERE userId = ? ORDER BY clockedInAt DESC` (member/admin walk
  /// history lookups) — a leftmost-prefix match also serves plain
  /// `WHERE userId = ?` queries, so this replaces the old userId-only index
  /// rather than sitting alongside it.
  @@index([userId, clockedInAt])
  @@index([conditionsPurgeAfter])
}

/// Public homepage carousel. Organisers can keep up to 3 slides.
model HomepageSlide {
  id        String   @id @default(cuid())
  sortOrder Int
  alt       String   @default("Bury Steps Walking Group")
  /// Bundled file such as /slides/bury-steps-hero.jpg. Null once an upload is stored.
  imagePath String?
  imageMime String?
  imageData Bytes?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

/// Public homepage testimonials. Organisers can keep up to 12.
model HomepageTestimonial {
  id        String   @id @default(cuid())
  sortOrder Int
  name      String
  /// Line under the name, e.g. "Member" or "Walk leader, Bury"
  role      String
  quote     String
  imagePath String?
  imageMime String?
  imageData Bytes?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

/// Filters on the public FAQ list. Organisers can keep up to 8.
model HomepageFaqCategory {
  id        String   @id @default(cuid())
  slug      String   @unique
  label     String
  sortOrder Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  faqs      HomepageFaq[]

  @@index([sortOrder])
}

/// Public homepage FAQs. Organisers can keep up to 20.
model HomepageFaq {
  id         String              @id @default(cuid())
  sortOrder  Int
  categoryId String
  category   HomepageFaqCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  question   String
  answer     String
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@index([sortOrder])
  @@index([categoryId])
}

/// Messages in the nav bell for signed-in members. Organisers can keep up to 10.
model SiteNotice {
  id        String   @id @default(cuid())
  title     String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  reads     SiteNoticeRead[]

  @@index([createdAt])
}

model SiteNoticeRead {
  noticeId String
  userId   String
  readAt   DateTime @default(now())

  notice SiteNotice @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([noticeId, userId])
  @@index([userId])
}

/// Singleton row (`id` is always `site`).
model SiteSetting {
  id                  String   @id
  /// Kept for existing rows. The public site is a fixed black-and-white theme.
  primaryColor        String
  /// When false, the homepage carousel is hidden.
  carouselEnabled     Boolean  @default(true)
  /// When false, the floating back-to-top button is hidden.
  scrollToTopEnabled  Boolean  @default(true)
  updatedAt           DateTime @updatedAt
}

/// Organiser-only accident reports. Printed from the report page.
model AccidentReport {
  id             String   @id @default(cuid())
  happenedAt     DateTime
  walkId         String?
  whatHappened   String
  whoInvolved    String
  whatWeDid      String
  organiserNotes String?
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  walk      Walk? @relation(fields: [walkId], references: [id], onDelete: SetNull)
  createdBy User  @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([happenedAt])
  @@index([walkId])
}
