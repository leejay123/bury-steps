generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MEMBER
  ADMIN
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String
  firstName String?
  lastName  String?
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now())

  /// Walk created/updated/cancelled notices. Default on — organiser-run
  /// content, not marketing.
  emailWalkAnnouncements   Boolean   @default(true)
  /// Digest of new /notices posts.
  emailNotices             Boolean   @default(true)
  /// Personal/group progress summaries (monthly clock-in goal, streaks).
  emailProgress            Boolean   @default(true)
  /// Newsletter campaigns. Off by default — needs explicit opt-in (PECR),
  /// separate from the account-lifecycle toggles above.
  emailNewsletter          Boolean   @default(false)
  /// New accident-report alerts, sent to organisers. Only consulted for
  /// ADMIN rows (see notifyOtherAdminsOfAccidentReport) — meaningless, and
  /// harmless, on a MEMBER row.
  emailAccidentAlerts      Boolean   @default(true)
  /// Lets the public preferences/one-click-unsubscribe page identify a
  /// member without requiring sign-in. Null for every row until first
  /// needed — generated lazily by getOrCreateUnsubscribeToken() rather than
  /// backfilled, so adding this column never touches existing rows.
  unsubscribeToken         String?   @unique
  /// Set when an organiser promotes this member while
  /// SiteSetting.organiserInviteRequired is on — role stays MEMBER until
  /// they click the emailed accept link (see acceptOrganiserInvite). Null
  /// once accepted, cancelled, or never invited; also null for every
  /// existing organiser, since a row only ever reaches ADMIN through this
  /// flow (or instantly, when the setting is off) — an ADMIN row is
  /// therefore always effectively "verified" with no separate flag needed.
  organiserInviteToken     String?   @unique
  organiserInviteSentAt    DateTime?
  organiserInviteExpiresAt DateTime?

  walksCreated            Walk[]                 @relation("WalkCreator")
  attendances             Attendance[]
  noticeReads             SiteNoticeRead[]
  accidentReports         AccidentReport[]
  journeyEvents           WalkJourneyEvent[]     @relation("JourneyCreator")
  impersonationsPerformed ImpersonationEvent[]   @relation("ImpersonationAdmin")
  impersonationsReceived  ImpersonationEvent[]   @relation("ImpersonationTarget")
  reportInvolvements      AccidentReportMember[]
  /// At most one SiteSetting row ever exists, so this is really 0-or-1 —
  /// Prisma still requires the relation's other side to be declared.
  contactMessagesOwnerFor SiteSetting[]          @relation("ContactMessagesOwner")

  @@index([createdAt])
}

model Walk {
  id              String    @id @default(cuid())
  /// Stable id used in clock-in forms and as a fallback share path: /w/<token>
  token           String    @unique
  /// Public share path: /w/<slug>. First place word, e.g. burrs. Same place again is burrs-2.
  slug            String?   @unique
  title           String
  description     String?
  location        String?
  /// Optional UK postcode used to place the map pin. Members still see `location`.
  postcode        String?
  /// Set from the meeting point via OpenStreetMap Nominatim. Null if unknown.
  latitude        Float?
  longitude       Float?
  /// Optional what3words address (e.g. "filled.count.soap"), stored as
  /// plain text and never resolved via their API — see src/lib/what3words.ts.
  /// Members get a link to what3words.com's own free page for pinpoint
  /// directions; the map above still comes from `location`/`postcode`.
  what3words      String?
  /// Stored in UTC. Always render with timeZone: "Europe/London".
  startsAt        DateTime
  durationMins    Int       @default(90)
  cancelledAt     DateTime?
  cancelledReason String?
  createdAt       DateTime  @default(now())
  /// Flagged by an organiser to exempt this walk from the cancelled-walk
  /// auto-delete cron, regardless of SiteSetting.cancelledWalkRetentionDays.
  /// Meaningless (and harmless) for a walk that was never cancelled.
  retentionLocked Boolean   @default(false)

  createdById String
  createdBy   User   @relation("WalkCreator", fields: [createdById], references: [id])

  attendances     Attendance[]
  accidentReports AccidentReport[]
  journeyEvents   WalkJourneyEvent[]

  @@index([startsAt])
  @@index([createdById])
  /// Used by the dashboard's "recently cancelled" window and the daily
  /// purge cron's cutoff query.
  @@index([cancelledAt])
}

model Attendance {
  id     String @id @default(cuid())
  walkId String
  userId String

  /// Set by the database, never by the client.
  clockedInAt      DateTime  @default(now())
  /// When the member left the walk. Null while they are still clocked in.
  clockedOutAt     DateTime?
  /// Why they clocked out. Visible to organisers only.
  clockedOutReason String?
  /// When the member gave explicit consent to store health information.
  medicalAckAt     DateTime

  /// UK GDPR Art. 9 special category data. Nullable — members may leave it blank.
  conditions           String?
  /// Cron/route clears `conditions` after this date. Retention limit.
  conditionsPurgeAfter DateTime

  walk Walk @relation(fields: [walkId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([walkId, userId])
  @@index([walkId])
  /// Speeds `WHERE walkId = ? AND clockedOutAt IS NULL` (on-walk counts,
  /// Add someone exclusions, share "who's coming").
  @@index([walkId, clockedOutAt])
  /// Covers `WHERE userId = ? ORDER BY clockedInAt DESC` (member/admin walk
  /// history lookups) — a leftmost-prefix match also serves plain
  /// `WHERE userId = ?` queries, so this replaces the old userId-only index
  /// rather than sitting alongside it.
  @@index([userId, clockedInAt])
  @@index([conditionsPurgeAfter])
}

/// Public homepage carousel. Organisers can keep up to 3 slides.
model HomepageSlide {
  id        String   @id @default(cuid())
  sortOrder Int
  alt       String   @default("Bury Steps Walking Group")
  /// Bundled file such as /slides/bury-steps-hero.jpg. Null once an upload is stored.
  imagePath String?
  imageMime String?
  imageData Bytes?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

/// Public homepage testimonials. Organisers can keep up to 12.
model HomepageTestimonial {
  id        String   @id @default(cuid())
  sortOrder Int
  name      String
  /// Line under the name, e.g. "Member" or "Walk leader, Bury"
  role      String
  quote     String
  imagePath String?
  imageMime String?
  imageData Bytes?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

/// Filters on the public FAQ list. Organisers can keep up to 8.
model HomepageFaqCategory {
  id        String        @id @default(cuid())
  slug      String        @unique
  label     String
  sortOrder Int
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  faqs      HomepageFaq[]

  @@index([sortOrder])
}

/// Public homepage FAQs. Organisers can keep up to 20.
model HomepageFaq {
  id         String              @id @default(cuid())
  sortOrder  Int
  categoryId String
  category   HomepageFaqCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  question   String
  answer     String
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@index([sortOrder])
  @@index([categoryId])
}

/// Filters for full-page notices on /notices. Organisers can keep up to 8.
model SiteNoticeCategory {
  id        String       @id @default(cuid())
  slug      String       @unique
  label     String
  sortOrder Int
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  notices   SiteNotice[]

  @@index([sortOrder])
}

/// Messages for the member bell and /notices.
/// BELL = short message in the drawer only. PAGE = teaser in the bell + full article at /notices/[slug].
/// The bell shows the pinned welcome (if enabled) plus the 20 newest other notices.
model SiteNotice {
  id         String              @id @default(cuid())
  title      String
  /// Short text shown in the bell (and as the card excerpt for PAGE notices).
  body       String
  kind       SiteNoticeKind      @default(BELL)
  /// Legacy field. New notices are always MEMBERS; bell and /notices require sign-in.
  audience   SiteNoticeAudience  @default(MEMBERS)
  /// Public path for PAGE notices: /notices/<slug>. Null for BELL.
  slug       String?             @unique
  /// Long article body for PAGE notices. Null for BELL.
  pageBody   String?
  categoryId String?
  category   SiteNoticeCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  /// Stable key for system notices (e.g. "welcome"). Not deletable; edit title/body only.
  systemKey  String?             @unique
  /// When false, the notice is hidden from the bell (and /notices if it were a page).
  /// Used to disable the pinned welcome without deleting it.
  enabled    Boolean             @default(true)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  reads      SiteNoticeRead[]

  @@index([createdAt])
  @@index([kind])
  @@index([audience])
  @@index([categoryId])
  @@index([enabled])
}

enum SiteNoticeKind {
  BELL
  PAGE
}

enum SiteNoticeAudience {
  /// Signed-in members (and organisers) only. The only audience the app uses.
  MEMBERS
  /// Legacy — no longer written or shown.
  PUBLIC
  /// Legacy — no longer written or shown.
  VISITORS
}

model SiteNoticeRead {
  noticeId String
  userId   String
  readAt   DateTime @default(now())

  notice SiteNotice @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([noticeId, userId])
  @@index([userId])
}

/// Singleton row (`id` is always `site`).
model SiteSetting {
  id                          String   @id
  /// Kept for existing rows. The public site is a fixed black-and-white theme.
  primaryColor                String
  /// When false, the homepage carousel is hidden.
  carouselEnabled             Boolean  @default(true)
  /// When false, the floating back-to-top button is hidden.
  scrollToTopEnabled          Boolean  @default(true)
  /// Cookie banner layout: default, small, or mini.
  cookieConsentVariant        String   @default("small")
  /// Public site name — header logo alt, homepage hero, tab titles, share cards.
  siteName                    String   @default("Bury Steps Walking Group")
  /// Homepage hero subtitle (also used for share/meta description when short enough).
  siteTagline                 String   @default("Sunday afternoons, Bury and the surrounding countryside. No winners, no losers — just people walking together.")
  /// Facebook group link. Empty string hides Facebook CTAs.
  facebookGroupUrl            String   @default("https://www.facebook.com/groups/burysteps")
  /// Homepage testimonials block.
  testimonialsEnabled         Boolean  @default(true)
  /// Optional small label above the testimonials heading. Empty hides it.
  testimonialsSectionEyebrow  String   @default("")
  /// Heading above the homepage testimonials grid.
  testimonialsSectionTitle    String   @default("From the group")
  /// Short intro under the testimonials heading.
  testimonialsSectionIntro    String   @default("A few words from people who walk with us on Sundays.")
  /// Homepage FAQs block.
  faqsEnabled                 Boolean  @default(true)
  /// Heading above the homepage FAQ list.
  faqSectionTitle             String   @default("Frequently asked questions")
  /// Short intro under the FAQ heading.
  faqSectionIntro             String   @default("How to join, what to bring, and how clock-in works. If you still have a question, ask in the Facebook group.")
  /// Homepage “How this started” block.
  howThisStartedEnabled       Boolean  @default(true)
  howThisStartedTitle         String   @default("How this started")
  howThisStartedEyebrow       String   @default("Kindness · Friendship · Welcome")
  howThisStartedTeaser        String   @default("What started out as a self-help mission to get myself fit after my diabetes diagnosis began with a simple goal: walking four miles a day with the dogs after work. It has grown into a community of walkers supporting one another week after week.")
  /// Full story in the About drawer (blank lines separate paragraphs). Empty uses the built-in default.
  howThisStartedBody          String   @default("")
  /// About drawer lists (one item per line). Empty uses built-in defaults.
  aboutGoals                  String   @default("")
  aboutPlaces                 String   @default("")
  aboutExpect                 String   @default("")
  /// About drawer rules: one “Title | Body” per line. Empty uses built-in defaults.
  aboutRules                  String   @default("")
  /// About drawer section headings — the real visible text (distinct from the Goals/Places/etc. admin-only labels).
  aboutGoalsHeading           String   @default("More than just a walking group")
  aboutPlacesHeading          String   @default("What we do")
  aboutExpectHeading          String   @default("What you can expect")
  aboutRulesHeading           String   @default("Group rules")
  /// Comma-separated homepage block order (howWalksWork, howThisStarted, memberNotices, testimonials, faqs).
  homepageSectionOrder        String   @default("howWalksWork,howThisStarted,memberNotices,testimonials,faqs")
  /// Signed-in members: latest notices carousel on the homepage.
  memberNoticesEnabled        Boolean  @default(true)
  /// Homepage “how it works” strip and walk-page “How this group works” card.
  howWalksWorkEnabled         Boolean  @default(true)
  /// Optional group clock-in target for the current UK month. Null hides Together.
  monthlyClockInGoal          Int?
  /// Uploaded site logo (header, print reports). Null uses the bundled default.
  logoMime                    String?
  logoData                    Bytes?
  /// Uploaded browser-tab favicon. Null uses the bundled default.
  faviconMime                 String?
  faviconData                 Bytes?
  /// Uploaded letterhead-style banner shown at the foot of printed accident
  /// reports. Separate from the logo — null hides the banner entirely
  /// (there is no bundled default for this one).
  reportBannerMime            String?
  reportBannerData            Bytes?
  /// Resend audience (Segment) id that newsletter subscribers are synced
  /// into. Created automatically on first use — see
  /// src/lib/email/resend-audience.ts — so there's nothing to configure by
  /// hand in the Resend dashboard.
  resendAudienceId            String?
  /// The single organiser who gets contact-form alert emails and is
  /// expected to reply (via the alert email's reply-to). Null means no one
  /// is notified. Cleared automatically if that organiser is removed
  /// (onDelete: SetNull) or demoted (see setMemberRole).
  contactMessagesOwnerId      String?
  /// When on, promoting a member to organiser sends an email invite
  /// instead of taking effect immediately — they only become an organiser
  /// once they accept it. Off by default (instant promotion, as before).
  organiserInviteRequired     Boolean  @default(false)
  /// Days a cancelled walk is kept before the daily cron deletes it (and
  /// its attendances) automatically, if it was never reopened. A linked
  /// accident report is unlinked, not deleted, along with it — reports
  /// have their own separate retention setting below. Null turns
  /// auto-delete off entirely. Defaulted to 30 on this column (matching
  /// this behaviour's original hardcoded value) so existing installs see
  /// no change unless an admin adjusts it.
  cancelledWalkRetentionDays  Int?     @default(30)
  /// Days an accident report is kept (counted from when it was logged,
  /// not the incident date, and not reset by later edits) before the
  /// daily cron deletes it automatically. Null (the default) turns
  /// auto-delete off — this is a new feature, not an existing behaviour
  /// being made configurable.
  accidentReportRetentionDays Int?
  updatedAt                   DateTime @updatedAt

  contactMessagesOwner User? @relation("ContactMessagesOwner", fields: [contactMessagesOwnerId], references: [id], onDelete: SetNull)
}

/// Organiser-only accident reports. Printed from the report page.
model AccidentReport {
  id              String   @id @default(cuid())
  happenedAt      DateTime
  walkId          String?
  whatHappened    String
  /// Free-text fallback — anyone not tagged via involvedMembers below
  /// (a passerby who isn't a member, or reports predating that feature).
  whoInvolved     String
  whatWeDid       String
  organiserNotes  String?
  createdById     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  /// Flagged by an organiser to exempt this report from the accident-report
  /// auto-delete cron, regardless of SiteSetting.accidentReportRetentionDays.
  retentionLocked Boolean  @default(false)

  walk      Walk? @relation(fields: [walkId], references: [id], onDelete: SetNull)
  createdBy User  @relation(fields: [createdById], references: [id], onDelete: Restrict)

  /// Members explicitly tagged as involved — lets an organiser follow up
  /// via the member's real profile instead of just a name in free text.
  involvedMembers AccidentReportMember[]

  @@index([happenedAt])
  @@index([walkId])
}

/// Join row: one member tagged as involved in one accident report.
model AccidentReportMember {
  reportId String
  userId   String

  report AccidentReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([reportId, userId])
  @@index([userId])
}

/// Story beats for a walk’s Journey timeline. Organisers add these during
/// or after the walk; members see them on the share page.
model WalkJourneyEvent {
  id          String   @id @default(cuid())
  walkId      String
  title       String
  body        String?
  /// When this moment happened (UK wall clock stored as UTC).
  happenedAt  DateTime
  createdAt   DateTime @default(now())
  createdById String

  walk      Walk @relation(fields: [walkId], references: [id], onDelete: Cascade)
  createdBy User @relation("JourneyCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([walkId, happenedAt])
}

/// Public "Contact Us" form submissions. Sending an admin alert + a
/// confirmation to the sender is handled by src/lib/email — see
/// src/server/actions/contact.ts.
model ContactMessage {
  id        String    @id @default(cuid())
  name      String
  email     String
  /// Optional — the form doesn't require it.
  phone     String?
  message   String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([createdAt])
}

/// Footer newsletter signups from visitors who aren't (or aren't yet)
/// members — a separate list from User.emailNewsletter, which covers
/// members who opted in from their own account.
model NewsletterSubscriber {
  id               String    @id @default(cuid())
  email            String    @unique
  /// Powers the public unsubscribe link — always set at creation, unlike
  /// User.unsubscribeToken, since this row only exists to be emailed.
  unsubscribeToken String    @unique @default(cuid())
  createdAt        DateTime  @default(now())
  unsubscribedAt   DateTime?

  @@index([createdAt])
}

/// Admin-edited subject/body text for one system email (keyed by
/// EmailTemplateKey in src/lib/email/registry.ts). Null fields — and a
/// missing row entirely — fall back to that registry's built-in default
/// text. Only the subject line and the main prose paragraph(s) are
/// editable; the shared layout (logo, button, footer, any data-driven
/// facts like a walk's time/place) is not stored here at all.
model EmailTemplateOverride {
  key       String   @id
  subject   String?
  body      String?
  updatedAt DateTime @updatedAt
}

/// One row per Resend webhook event received (email.sent/delivered/bounced/
/// complained/opened/clicked/...). Populated by
/// src/app/api/webhooks/resend/route.ts so bounces and spam complaints are
/// visible after the fact instead of just failing silently. `resendId` is
/// Resend's own email id, present on every event type it sends.
model EmailEvent {
  id        String   @id @default(cuid())
  resendId  String
  type      String
  recipient String
  createdAt DateTime @default(now())
  data      Json

  @@index([resendId])
  @@index([recipient])
  @@index([createdAt])
}

/// Audit trail for "log in as this member" (Clerk actor tokens) — see
/// src/server/actions/impersonation.ts. Rows are never deleted, including
/// when either User row is later removed (SetNull), so the log stays
/// accurate even after someone's account is deleted.
model ImpersonationEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  adminId    String?
  admin      User?   @relation("ImpersonationAdmin", fields: [adminId], references: [id], onDelete: SetNull)
  /// Kept even if the admin row is later deleted/demoted — the log line
  /// should still say who did this.
  adminName  String
  adminEmail String

  targetId    String?
  target      User?   @relation("ImpersonationTarget", fields: [targetId], references: [id], onDelete: SetNull)
  targetName  String
  targetEmail String

  @@index([createdAt])
}
